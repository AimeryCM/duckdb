# name: test/sql/pragma/profiling/test_profiling_bytes_scanned_read_file.test
# description: Test query.total_bytes_scanned and operator.bytes_scanned for read_blob and read_text
# group: [profiling]

require parquet

require json

statement ok
COPY (SELECT range AS i FROM range(10000)) TO '{TEST_DIR}/rb.csv';

statement ok
COPY (SELECT range AS i FROM range(10000)) TO '{TEST_DIR}/rb.csv.gz' (COMPRESSION gzip);

statement ok
COPY (SELECT range AS i FROM range(2048)) TO '{TEST_DIR}/bytes_scanned_rb.parquet';

statement ok
CREATE TABLE sizes AS SELECT parse_filename(filename) AS name, size FROM read_blob(['{TEST_DIR}/rb.csv', '{TEST_DIR}/rb.csv.gz']);

query I
SELECT bool_and(size > 0) AND count(*) = 2 FROM sizes;
----
true

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/bytes_scanned_read_file_blob_content.json';

statement ok
SET tracked_metrics = ['query.total_bytes_scanned'];

statement ok
SELECT octet_length(content) FROM read_blob('{TEST_DIR}/rb.csv');

statement ok
PRAGMA disable_profiling;

query I
SELECT query.total_bytes_scanned = (SELECT size FROM sizes WHERE name = 'rb.csv')
FROM '{TEST_DIR}/bytes_scanned_read_file_blob_content.json';
----
true

statement ok
SET enable_profiling = 'json';

statement ok
SET profiling_output = '{TEST_DIR}/bytes_scanned_read_file_text_content.json';

statement ok
SET tracked_metrics = ['query.total_bytes_scanned'];

statement ok
SELECT length(content) FROM read_text('{TEST_DIR}/rb.csv');

statement ok
PRAGMA disable_profiling;

query I
SELECT query.total_bytes_scanned = (SELECT size FROM sizes WHERE name = 'rb.csv')
FROM '{TEST_DIR}/bytes_scanned_read_file_text_content.json';
----
true

